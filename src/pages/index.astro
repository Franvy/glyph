---
import { Image } from "astro:assets";
import Calendar from "@lucide/astro/icons/calendar";
import Mail from "@lucide/astro/icons/mail";
import Band from "@/components/band.astro";
import BrandIcon from "@/components/brand-icon.astro";
import { HostClock } from "@/components/clock";
import Contributions from "@/components/contributions.astro";
import HoverCards from "@/components/hover-cards.astro";
import Mark from "@/components/mark.astro";
import { Meiqiu } from "@/components/meiqiu";
import { ProjectCard } from "@/components/project-card";
import ProjectFigure from "@/components/project-figure.astro";
import SectionHead from "@/components/section-head.astro";
import SoundToggle from "@/components/sound-toggle.astro";
import Streak from "@/components/streak.astro";
import ThemeToggle from "@/components/theme-toggle.astro";
import { BannerShader } from "@/components/shaders";
import Base from "@/layouts/base.astro";
import { env } from "cloudflare:workers";
import { duolingoLink, getContent, siteWith, socialsOf } from "@/lib/content";
import { homeContributions } from "@/data/contributions";
import { figureOf } from "@/data/figures";
import { homeDuolingo } from "@/data/duolingo";
import { homeGitHub } from "@/data/github-profile";
// Pre-sized from avatar.png (360px): this page renders on demand, where the Cloudflare adapter's "compile" image
// service only passes files through, so <Image /> cannot resize here.
import avatar from "@/assets/images/avatar-160.webp";
import duolingoLogo from "@/assets/logos/duolingo.svg";
import limnsCc from "@/assets/logos/limns-cc.svg";
import limnsDev from "@/assets/logos/limns-dev.svg";

// On demand: the content comes from D1, so an edit in /admin shows on the next load.
export const prerender = false;

const content = await getContent(env.DB);
const site = siteWith(content.profile);
const socials = socialsOf(content.profile);
const { projects, skills } = content;
const [contributions, gh, duo] = await Promise.all([homeContributions(), homeGitHub(), homeDuolingo(site.duolingo)]);
// The intro names two projects. The GitHub card lists the ones still on the list in /admin.
const intro = ["limns.cc", "limns.dev"].filter((name) => projects.some((p) => p.name === name));
const duolingoHref = site.duolingo ? duolingoLink(site.duolingo) : null;
---

<Base
  title={site.name}
  description="Full-stack developer and indie developer. Small, well-designed, practical products: limns.cc and limns.dev."
>
  <header class="band enter" style="--i: 0" id="top">
    <div class="rail p-3 max-sm:p-4">
      <!-- A phone keeps the 666:220 shape of the desktop banner (Paper: Home · v6 mobile 390). -->
      <div class="dot-field relative h-[220px] overflow-hidden max-sm:aspect-[666/220] max-sm:h-auto">
        <BannerShader client:only="react" scene={content.banner.scene} />
      </div>
    </div>
  </header>

  <main>
    <Band i={1} class="p-3 max-sm:p-4" aria-label="Who">
      <div class="flex justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="shrink-0 rounded-lg border-[1.5px] border-frame p-[3px]">
            <div class="size-20 overflow-clip rounded-[5px] bg-[#18181b]">
              <Image src={avatar} alt="A hand-painted Pikachu in the grass" width={160} height={160} class="avatar size-full object-cover" />
            </div>
          </div>
          <div class="flex flex-col justify-center self-end">
            <h1 class="mb-0.5 font-sans text-2xl leading-none tracking-[-0.02em] text-name">{site.name}</h1>
            <p class="font-sans text-sm leading-[1.5] text-sub">{site.headline}</p>
          </div>
        </div>
        <div class="flex flex-col items-end justify-between">
          <div class="flex items-center gap-3 text-sm">
            <SoundToggle />
            <ThemeToggle />
          </div>
          <HostClock client:visible timeZone={site.timeZone} city={site.city} />
        </div>
      </div>
    </Band>

    <Band i={2} class="relative px-3 pt-4 pb-6 max-sm:px-4" aria-label="About" id="about">
      <div class="flex flex-col gap-4 font-sans text-base leading-[26px] text-body">
        <p>
          Hi, I’m {site.name}, a full-stack developer who also does a bit of UI/UX design. As an indie developer I’ve built two
          products: <Mark href="#projects" logo={limnsCc}>limns.cc</Mark>, an AI platform that puts many models in one place,
          and <Mark href="#projects" logo={limnsDev}>limns.dev</Mark>, a site for collecting design inspiration. I like small,
          well-designed, practical products.
        </p>
        <p>
          I build with React, Next.js and Java. I use Claude Code, an AI coding tool, and Paper, a design tool I really love. I’m
          always learning English{
            duolingoHref && (
              <a
                href={duolingoHref}
                data-streak={duo ? "" : undefined}
                aria-label={duo ? `Duolingo: ${duo.streak}-day streak` : "Duolingo"}
                class="ml-1 inline-block align-[-2px]"
              >
                <img src={duolingoLogo.src} alt="" width="14" height="14" class="mark-icon block size-3.5" />
              </a>
            )
          } (it’s still pretty bad). Feel free to{" "}
          <a class="link whitespace-nowrap font-medium" href={`mailto:${site.email}`}>email me</a>, I’d love to chat.
        </p>
      </div>

      <!-- On a phone both buttons only just fit on one row, and the font decides if they wrap. Each takes a full row. -->
      <div class="flex flex-wrap gap-2 pt-[18px]">
        {
          site.booking && (
            <a href={site.booking} class="cta cta-primary press flex items-center gap-1.5 px-2.5 py-1.5 text-sm leading-5 font-medium whitespace-nowrap max-sm:basis-full max-sm:justify-center max-sm:py-[9px]">
              <span class="cta-icon" aria-hidden="true">
                <Calendar size={14} />
                <Calendar size={14} />
              </span>
              Book an intro call
            </a>
          )
        }
        <a
          href={`mailto:${site.email}`}
          class:list={[
            "cta press flex items-center gap-1.5 px-2.5 py-1.5 text-sm leading-5 font-medium whitespace-nowrap max-sm:basis-full max-sm:justify-center max-sm:py-[9px]",
            // Next to the intro call, email steps back to the outlined button.
            site.booking ? "cta-secondary" : "cta-primary",
          ]}
        >
          <span class="cta-icon" aria-hidden="true">
            <Mail size={14} />
            <Mail size={14} />
          </span>
          Send an email
        </a>
      </div>

      <div class="py-[18px]">
        <ul class="flex flex-wrap gap-[7px]">
          {
            socials.map((s) => (
              <li>
                <a href={s.href} data-hovercard-for={s.icon} class="chip flex items-center gap-1.5 bg-card px-2 py-1 text-[13px] leading-5 text-body">
                  <BrandIcon name={s.icon} class="text-mute" />
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div id="contributions" class="scroll-mt-6 pt-2.5 pb-6">
        <Contributions year={contributions} />
      </div>

      <HoverCards
        name={site.name}
        github={site.github}
        x={site.x}
        xFollowing={site.xFollowing}
        xFollowers={site.xFollowers}
        bio={`${site.headline} in ${site.city}. Code for ${intro.join(", ").replace(/, ([^,]*)$/, " and $1")}.`}
        year={contributions}
        gh={gh}
      />
      {duo && <Streak streak={duo.streak} />}
    </Band>

    <SectionHead id="projects" title="Projects" i={3} />
    <Band i={4} aria-labelledby="projects">
      <ul class="grid grid-cols-2 max-sm:grid-cols-1">
        {
          projects.map((project) => (
            <ProjectCard client:visible project={project} figure={Boolean(figureOf(project.name))}>
              <ProjectFigure project={project.name} />
            </ProjectCard>
          ))
        }
      </ul>
    </Band>

    <SectionHead id="skills" title="Skills & Technologies" i={5} />
    <Band i={6} class="p-3 max-sm:p-4" aria-labelledby="skills">
      <ul class="flex flex-wrap gap-1.5">
        {
          skills.map((skill) => (
            <li class="skill flex grow items-center justify-center gap-2 border border-edge px-2 py-1 text-[13px] leading-5 text-dim">
              {/* Cleaned on save by src/lib/svg.ts: only shapes and paint, so it is safe inline. */}
              {skill.svg && <span class="skill-mark flex shrink-0 text-mute" set:html={skill.svg} />}
              {skill.name}
            </li>
          ))
        }
      </ul>
    </Band>
  </main>

  <footer class="footer enter" style="--i: 7">
    <div class="rail px-3 pt-8 pb-16 text-sm leading-5 max-sm:px-4">
      <Meiqiu client:visible year={new Date().getFullYear()} owner={site.name} repo={site.repo} />
    </div>
  </footer>
</Base>
