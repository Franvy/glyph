# ── Database: D1 is a binding, declared in wrangler.jsonc. There is no DATABASE_URL.

# ── Worker vars (not secret): set in wrangler.jsonc "vars". Locally, .dev.vars can override them.
# pnpm dev skips the Access check, so you do not need them to edit content locally.
# ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# ACCESS_AUD=

# ── Secrets: .dev.vars locally, `pnpm dlx wrangler secret put <NAME>` in production.
# GitHub token for the contribution calendar (GraphQL needs one). A fine-grained token with no permissions is enough.
# Without it the home page shows the days already in D1, or an empty calendar.
# GITHUB_TOKEN=
# Caiyun weather token for the banner (https://docs.caiyunapp.com/weather-api/). Its realtime sky comes from radar.
# Without it the banner asks Open-Meteo, which is a model and can miss a light shower.
# CAIYUN_TOKEN=

# ── CI only (GitHub Secrets, never in a local file)
# CLOUDFLARE_API_TOKEN=     # Workers + D1 edit permission
# CLOUDFLARE_ACCOUNT_ID=
